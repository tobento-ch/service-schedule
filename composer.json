{
    "name": "tobento/service-schedule",
    "version": "2.0.1",
    "type": "library",
    "description": "A task schedule system for running tasks at specific intervals.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "schedule",
        "task"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^3.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "tobento/service-autowire": "^2.0",
        "tobento/service-file-creator": "^2.0",
        "tobento/service-collection": "^2.0",
        "dragonmantank/cron-expression": "^3.4",
        "butschster/cron-expression-generator": "^1.10"
    },
    "suggest": {
        "tobento/service-console": "To support command tasks",
        "tobento/service-event": "May be used to support schedule and task events",
        "tobento/service-cache": "May be used to support task without overlapping",
        "tobento/service-mail": "May be used to support sending mails",
        "tobento/service-notifier": "May be used to support sending notifications",
        "symfony/process": "Required to support the process task",
        "nyholm/psr7": "Required to support the ping task (PSR-17 factories)",
        "symfony/http-client": "Required to support the ping task (PSR-18 client)"
    },    
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/service-container": "^2.0",
        "tobento/service-clock": "^2.0",
        "tobento/service-console": "^2.0",
        "tobento/service-event": "^2.0",
        "tobento/service-cache": "^2.0",
        "tobento/service-mail": "^2.0",
        "tobento/service-notifier": "^2.0",
        "nyholm/psr7": "^1.8",
        "symfony/http-client": "^8.0",
        "symfony/process": "^7.3",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Schedule\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Schedule\\Test\\": "tests",
            "Tobento\\Service\\Console\\Test\\": "vendor/tobento/service-console/tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}